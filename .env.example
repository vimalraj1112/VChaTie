# Copy this file to `.env` and fill in real values.
# NEVER commit your real .env file.

# Generate a strong key, e.g.:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=replace-me-with-a-random-secret-key

# Set to False in production.
DEBUG=False

# ===== Local MySQL database =====
DATABASE_URL=
DB_NAME=chatie_db
DB_USER=root
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=3306

# ===== Redis (channel layer) =====
# On Windows use Memurai; on Render use the provided external Redis URL.
REDIS_URL=redis://127.0.0.1:6379

# ===== Cloudinary (optional; used in production for media hosting) =====
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ===== Optional auto-created superuser (python manage.py create_admin) =====
ADMIN_USERNAME=
ADMIN_PASSWORD=